cinnamon: Cinnamon Panel {
  shape: rectangle
}

applet: applet.js {
  shape: rectangle

  timer: Mainloop poll timer\n(~2s, single GLib source) {
    shape: rectangle
  }

  state_machine: State machine\n(idle / camera / mic / both) {
    shape: rectangle
  }

  mic_availability: mic detection availability\n(true / false, sticky) {
    shape: rectangle
  }

  screen_share_state: screen-share active\n(bool, orthogonal to state machine) {
    shape: rectangle
  }

  panel_icon: St.Icon panel display {
    shape: rectangle
  }

  popup_menu: Click popup menu\n(process list) {
    shape: rectangle
  }

  timer -> state_machine: triggers poll
}

fuser: fuser <videoN...>\n(Gio.Subprocess, async) {
  shape: rectangle
}

pw_dump: pw-dump\n(Gio.Subprocess, async) {
  shape: rectangle
}

proc: /proc/<pid>/comm {
  shape: rectangle
}

dev_video: /dev/video* {
  shape: cylinder
}

pipewire_graph: PipeWire native graph\n(nodes, state: running/idle) {
  shape: rectangle
}

screen_share_helper: screen_share_helper.py\n(persistent process, python3-xlib,\nPR_SET_PDEATHSIG) {
  shape: rectangle
}

x11_record: X11 RECORD extension\n(replicates CopyArea, GetImage, ShmGetImage,\nGetCursorImage, NameWindowPixmap, FreePixmap) {
  shape: cylinder
}

x11_xres: X-Resource extension\n(id_base -> PID) {
  shape: cylinder
}

cinnamon -> applet: loads
applet.timer -> fuser: spawn (camera check)
applet.timer -> pw_dump: spawn (mic check)
fuser -> dev_video: queries holders of
fuser -> proc: PID -> process name lookup
pw_dump -> pipewire_graph: dumps
fuser -> applet.state_machine: PIDs
pw_dump -> applet.state_machine: Stream/Input/Audio nodes\nwith state=running
pw_dump -> applet.mic_availability: GLib.SpawnError.NOENT ->\nfalse (once, logged)
applet.mic_availability -> applet.panel_icon: overrides hidden idle icon\nwith error.svg when false
applet.state_machine -> applet.panel_icon: sets state
applet.state_machine -> applet.popup_menu: updates process list
applet.panel_icon -> applet.popup_menu: click opens

applet -> screen_share_helper: spawn once at startup\n(not per poll-tick); killed in\non_applet_removed_from_panel
screen_share_helper -> x11_record: watches (debounced:\n3 matches / 1.5s = "active")
screen_share_helper -> x11_xres: resolves id_base -> PID
screen_share_helper -> applet.screen_share_state: READY / ACTIVE <pids> / IDLE\n(stdout, read_line_async)
applet.screen_share_state -> applet.panel_icon: draws red ring overlay\non whichever base icon shows
applet.screen_share_state -> applet.popup_menu: adds "Screen capture:" section

message_tray: Cinnamon message tray\n(notification list; drops all when\n"Do not disturb" is on) {
  shape: rectangle
}

applet.state_machine -> message_tray: Camera / Microphone in use\nwhen a new process starts\n(if notifications-enabled)
applet.screen_share_state -> message_tray: Screen being captured\nwhen a new process starts
